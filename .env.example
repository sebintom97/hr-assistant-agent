# Copy to .env (git ignored) and change the values. Never commit .env.

# Password for the local Postgres container. Only reachable from your own machine.
POSTGRES_PASSWORD=change-me

# Host port for Postgres. Change it if you already run Postgres locally on 5432.
POSTGRES_PORT=5432

# Host port for hr-core. Change it if 8080 is taken.
HR_CORE_PORT=8080
