# Copy to .env (git ignored). Never commit .env, and never put a real key in this file.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# hr-core base URL (your HR_CORE_PORT from the root .env)
HR_CORE_URL=http://127.0.0.1:8080
# Claude model id (check https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-haiku-5-5
